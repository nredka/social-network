# Copy this file to .env and adjust the values. Never commit the real .env.
APP_NAME="IT Cluster Social Network"
ENVIRONMENT=development
DEBUG=false

# PostgreSQL container (read by docker compose)
POSTGRES_USER=social
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_network

# Connection string used by the app and Alembic (keep in sync with the values above)
DATABASE_URL=postgresql+psycopg://social:change-me@localhost:5432/social_network
