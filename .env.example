# Copy this file to .env and adjust the values. Never commit the real .env.
APP_NAME="IT Cluster Social Network"
ENVIRONMENT=development
DEBUG=false

# PostgreSQL container (read by docker compose)
POSTGRES_USER=social
POSTGRES_PASSWORD=change-me
POSTGRES_DB=social_network

# Connection string used by the app and Alembic (keep in sync with the values above)
DATABASE_URL=postgresql+psycopg://social:change-me@localhost:5432/social_network

# Database used by the test suite. Its name must end with _test: the tests refuse to
# run otherwise. Create it with:
#   docker compose exec db sh -c 'psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "CREATE DATABASE social_network_test"'
TEST_DATABASE_URL=postgresql+psycopg://social:change-me@localhost:5432/social_network_test

# Secret used to sign access tokens (at least 32 characters). Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Docker Compose only: the host port of the API container (default 8000).
# API_PORT=8000

# Docker Compose only: the host port of the database container (default 5432). Change
# it if a PostgreSQL of your own already uses 5432. The app and the tests run on the host
# connect through this port, so then use the same port in DATABASE_URL and
# TEST_DATABASE_URL above (the containers are not affected: they use the name "db").
# DB_PORT=5432

# Production only (compose.prod.yml): which published image to run. In production pin
# an immutable "sha-..." tag (copy it from the repository's Packages page): "latest"
# moves with every release, so you could not tell what is running or roll back to it.
# IMAGE_TAG=sha-1a2b3c4
